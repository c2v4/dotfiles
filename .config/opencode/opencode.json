{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@slkiser/opencode-quota",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@plannotator/opencode@latest"
  ],
  "autoupdate": false,
  "mcp": {
    "servers": {
      "donsetch": {
        "type": "local",
        "command": [
          "donsetch",
          "mcp",
          "--supervised"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "provider": {
    "opencode-go": {},
    "opencode": {}
  }
}
